// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "title_bar": {
    "show_sign_in": false
  },
  "terminal": {
    "dock": "right"
  },
  "disable_ai": true,
  "cli_default_open_behavior": "existing_window",
  "vim": {
    "toggle_relative_line_numbers": true
  },
  "gutter": {
    "line_numbers": true
  },
  "icon_theme": "Material Icon Theme",
  "which_key": {
    "delay_ms": 600,
    "enabled": true
  },
  "language_models": {
    "opencode": {
      "show_go_models": false,
      "show_zen_models": false
    }
  },
  "agent_servers": {
    "opencode": {
      "type": "registry"
    }
  },
  "project_panel": {
    "dock": "left"
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "agent": {
    "dock": "right",
    "favorite_models": [],
    "model_parameters": []
  },
  "git_panel": {
    "dock": "left"
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "vim_mode": true,
  "relative_line_numbers": "wrapped",
  "base_keymap": "VSCode",
  "ui_font_family": "Geist Mono",
  "ui_font_size": 16,
  "buffer_font_family": "GeistMono Nerd Font",
  "buffer_font_size": 19.0,
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "Catppuccin Macchiato (Blur) [Heavy]",
  },
  "lsp": {
    "jdtls": {
      "settings": {
        "java_home": "/usr/lib/jvm/java-21-openjdk"
      },
      "initialization_options": {
        "settings": {
          "java": {
            "configuration": {
              "updateBuildConfiguration": "disabled"
            }
          }
        }
      }
    }
  },
  }
